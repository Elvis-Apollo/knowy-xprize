# Gemini Developer API path (fastest local setup).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Preferred XPRIZE production path: Gemini on Google Cloud Vertex AI.
# Supply a short-lived access token through the hosting environment.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_ACCESS_TOKEN=

# Real GitHub connector. The defaults work with a public repository.
GITHUB_REPOSITORY=openai/openai-node
GITHUB_TOKEN=
